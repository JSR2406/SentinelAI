# SentinelAI Production Environment Variables

# App & Environment Configuration
ENV=production
DEBUG=false
SECRET_KEY=generate-a-strong-random-secret-key-here

# Database Settings (Managed Postgres or Supabase DB)
DATABASE_URL=postgresql://sentinel_admin:SentinelAI_Prod_Pass_2026!@postgres:5432/sentinelai_db
POSTGRES_USER=sentinel_admin
POSTGRES_PASSWORD=SentinelAI_Prod_Pass_2026!
POSTGRES_DB=sentinelai_db

# Redis Task Queue Settings
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# Supabase Auth Configuration
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-from-api-settings

# OpenAI API Configuration (for Vulnerability Remediations & Auto-fixes)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# GitHub OAuth App Credentials (for Login & Repo Sync)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_REDIRECT_URI=https://your-domain.com/auth/github/callback

# Notification Webhook URLs
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
